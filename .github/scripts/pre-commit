#!/usr/bin/env bash
# Git pre-commit hook (enforcement).
# - Emoji are banned in every staged text file EXCEPT CI workflow files, where
#   they are allowed in job/step names.
# - Blocked phrases are rejected too, EXCEPT in files whose purpose is to document
#   the rule (the check scripts and the term list), which
#   legitimately contain those phrases as examples.
set -euo pipefail
ROOT="$(git rev-parse --show-toplevel)"
# shellcheck source=/dev/null
source "$ROOT/.github/scripts/lib.sh"

is_binary() {
  case "$1" in
    *.png|*.jpg|*.jpeg|*.gif|*.pdf|*.ico|*.svg|*.woff|*.woff2|*.ttf|*.eot|*.zip|*.gz|*.jar|*.keystore) return 0 ;;
    *) return 1 ;;
  esac
}

# Paths exempt from the blocked-phrase text scan (still subject to the emoji scan).
text_exempt() {
  case "$1" in
    .github/scripts/*|*/.github/scripts/*) return 0 ;;
    governance/*|*/governance/*) return 0 ;;
    .github/workflows/*|*workflows/*.yml|*workflows/*.yaml) return 0 ;;
    *text-hygiene-terms.txt|*docs-allowed-terms.txt) return 0 ;;
    *) return 1 ;;
  esac
}

# Paths where emoji ARE allowed: Markdown docs (the lite emoji style), GitHub
# config (CI workflow job/step names and release-drafter category titles), and
# a governance/github/ folder holding the same kind of config.
emoji_exempt() {
  case "$1" in
    .github/*|*/.github/*) return 0 ;;
    *.md) return 0 ;;
    NOTES.txt|*/NOTES.txt) return 0 ;;
    governance/github/*) return 0 ;;
    *) return 1 ;;
  esac
}

fail=0
while IFS= read -r f; do
  [ -f "$f" ] || continue
  case "$f" in .git/*) continue ;; esac
  is_binary "$f" && continue

  if ! emoji_exempt "$f"; then
    emoji="$(gov_find_emoji < "$f")"
    if [ -n "$emoji" ]; then echo "pre-commit: emoji not allowed in $f:" >&2; echo "$emoji" >&2; fail=1; fi
  fi

  if ! text_exempt "$f"; then
    issues="$(gov_find_file_issues "$f")"
    if [ -n "$issues" ]; then echo "pre-commit: blocked phrase not allowed in $f:" >&2; echo "$issues" >&2; fail=1; fi
  fi
done < <(git diff --cached --name-only --diff-filter=ACM)

[ "$fail" -eq 0 ] || { echo "pre-commit: blocked. Remove the above before committing." >&2; exit 1; }
exit 0
